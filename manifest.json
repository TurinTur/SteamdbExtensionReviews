{
  "manifest_version": 3,
  "name": "SteamDB Non-Chinese Reviews",
  "version": "1.1.3",
  "description": "Displays user review scores and statistics on SteamDB app pages and sales tables excluding Simplified & Traditional Chinese reviews.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://steamdb.info/*"
  ],
  "optional_host_permissions": [
    "https://api.steampowered.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://steamdb.info/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "steamdb-non-chinese-reviews@antigravity",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [ "none" ]
      }
    }
  }
}
